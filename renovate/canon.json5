// Канон alxwlw/stack для Renovate: всё, что двигает `stack sync`, бот у потребителя не трогает —
// иначе его PR разводят репо с каноном, а следующий sync откатывает их обратно.
// Подключение: extends: ['config:recommended', 'github>alxwlw/stack//renovate/canon.json5#v1'].
// Только `enabled: false` и выдержка npm, которую диктует pnpm канона: группы, расписание, ignorePaths и прочее
// остаются за потребителем.
{
	$schema: 'https://docs.renovatebot.com/renovate-schema.json',
	// Статус renovate/stability-days выключен с тех пор, когда Renovate шёл под PAT без права на commit statuses
	// (403, и Renovate бросал весь прогон). Выдержка работает и без статуса.
	statusCheckNames: { minimumReleaseAge: null },
	packageRules: [
		{
			description: 'Пакеты канона и ссылки на workflow/action стека (alxwlw/stack/...@v1) двигает stack sync',
			matchPackageNames: ['@alxwlw/**', 'alxwlw/stack'],
			enabled: false,
		},
		{
			description: 'Каталоги канона (dev, libs), packageManager и engines принадлежат канону',
			matchDepTypes: ['pnpm.catalog.dev', 'pnpm.catalog.libs', 'packageManager', 'engines'],
			enabled: false,
		},
		{
			description: 'Пины .prototools принадлежат канону',
			matchManagers: ['proto'],
			enabled: false,
		},
		{
			description: 'Образы node и oven/bun в Dockerfile повторяют пины .prototools: их двигает stack sync',
			matchManagers: ['dockerfile'],
			matchPackageNames: ['node', 'oven/bun'],
			enabled: false,
		},
		{
			description: 'Версии node, bun и proto во входах with шагов workflow повторяют пины .prototools: их двигает stack sync',
			matchDepTypes: ['uses-with'],
			matchDepNames: ['node', 'bun', 'moonrepo/proto'],
			enabled: false,
		},
		{
			description: 'Где pnpm-workspace.yaml сам задаёт minimumReleaseAge (строгий режим), pnpm 12 не ставит npm-версию моложе этого срока: Renovate не предлагает её раньше, иначе лок не обновится и PR покраснеет; без явного значения встроенные сутки pnpm нестрогие и откатываются на прежнюю версию',
			matchDatasources: ['npm'],
			minimumReleaseAge: '1 day',
		},
	],
}
