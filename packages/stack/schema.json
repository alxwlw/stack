{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "stack config (.stack.jsonc)",
	"type": "object",
	"properties": {
		"$schema": { "type": "string" },
		"profile": {
			"type": "string",
			"enum": ["node", "contracts", "infra"],
			"description": "Repo profile: picks which canon verbatim files get synced."
		},
		"with": {
			"type": "array",
			"description": "Opt-in canon groups.",
			"items": {
				"type": "string",
				"enum": ["moon-tasks", "libs", "knip", "depcruise"]
			}
		},
		"exceptions": {
			"type": "array",
			"description": "Suppressed `stack check` findings. Each exception addresses exactly one canon file or exactly one catalog entry.",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"file": { "type": "string", "minLength": 1 },
					"catalog": { "type": "string", "minLength": 1 },
					"name": { "type": "string", "minLength": 1 },
					"reason": { "type": "string", "minLength": 1 }
				},
				"required": ["reason"],
				"oneOf": [
					{
						"required": ["file"],
						"not": { "anyOf": [{ "required": ["catalog"] }, { "required": ["name"] }] }
					},
					{
						"required": ["catalog", "name"],
						"not": { "required": ["file"] }
					}
				]
			}
		}
	},
	"required": ["profile"],
	"additionalProperties": false
}
