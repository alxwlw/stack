{
	// @alxwlw/oxlint-config — nest preset = node + the Nest-DI guard.
	// stack/require-nest-di-decorator: in a DI-managed class (@Injectable/
	// @Controller/@Catch) every ctor param with a default value must carry
	// @Optional() — SWC/Bun-class transpilers strip emitDecoratorMetadata, so
	// without it Nest treats the param as a required dependency and throws
	// UnknownDependenciesException at runtime while tsc/local dev pass.
	// The preset also turns off typescript/consistent-type-imports — see the rule.
	"extends": ["./node.jsonc"],
	"rules": {
		"stack/require-nest-di-decorator": "error",
		// NestJS guards/interceptors are async for the CanActivate/
		// NestInterceptor contract (surface throws as rejections) without an
		// inner await — require-await is all false positives there.
		"typescript/require-await": "off",
		// oxlint does not model emitDecoratorMetadata: the consistent-type-imports
		// autofix turns a class injected by ctor-param type into `import type`, so
		// no type metadata is emitted and Nest DI fails at startup
		// (UnknownDependenciesException) while tsc and lint stay green.
		"typescript/consistent-type-imports": "off",
	},
}
