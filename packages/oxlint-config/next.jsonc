{
	// @alxwlw/oxlint-config — next preset = react + oxlint's Next.js plugin
	// (correctness-category nextjs rules: no-img-element pitfalls,
	// no-html-link-for-pages, google-font hygiene, …). For Next.js apps,
	// extend this from the repo root.
	// NOTE oxlint merges `plugins` across `extends`; the full list is restated on
	// purpose so the preset reads as one file (kept complete by oxlint-config.test.ts).
	"extends": ["./react.jsonc"],
	"plugins": ["typescript", "oxc", "unicorn", "import", "react", "jsx-a11y", "nextjs"],
}
