{
	// @alxwlw/oxlint-config — react preset = base + react/react-hooks/jsx-a11y
	// layers (react-hooks classic pair, eslint-plugin-react flat/recommended +
	// jsx-runtime, jsx-a11y recommended).
	// Intended usage: drop a nested `.oxlintrc.json` extending this preset into
	// the browser-code root (oxlint auto-discovers nested configs per subtree),
	// or extend it from the repo root when the whole repo is a frontend.
	// NOTE top-level `plugins` REPLACES the inherited set — the full list is
	// restated here on purpose.
	"extends": ["./base.jsonc"],
	"plugins": ["typescript", "oxc", "unicorn", "import", "react", "jsx-a11y"],
	"env": {
		"builtin": true,
		"node": true,
		"browser": true,
		"es2024": true,
	},
	"rules": {
		"react/rules-of-hooks": "error",
		"react/exhaustive-deps": "error",
		"react/jsx-key": "error",
		"react/jsx-no-comment-textnodes": "error",
		"react/jsx-no-duplicate-props": "error",
		"react/jsx-no-target-blank": "error",
		"react/jsx-no-undef": "error",
		"react/no-children-prop": "error",
		"react/no-danger-with-children": "error",
		"react/no-direct-mutation-state": "error",
		"react/no-find-dom-node": "error",
		"react/no-is-mounted": "error",
		"react/no-render-return-value": "error",
		"react/no-string-refs": "error",
		"react/no-unescaped-entities": "error",
		"react/no-unknown-property": "error",
		"jsx-a11y/alt-text": "error",
		"jsx-a11y/anchor-has-content": "error",
		"jsx-a11y/anchor-is-valid": "error",
		"jsx-a11y/aria-activedescendant-has-tabindex": "error",
		"jsx-a11y/aria-props": "error",
		"jsx-a11y/aria-role": "error",
		"jsx-a11y/aria-unsupported-elements": "error",
		"jsx-a11y/autocomplete-valid": "error",
		"jsx-a11y/click-events-have-key-events": "error",
		"jsx-a11y/heading-has-content": "error",
		"jsx-a11y/html-has-lang": "error",
		"jsx-a11y/iframe-has-title": "error",
		"jsx-a11y/img-redundant-alt": "error",
		"jsx-a11y/label-has-associated-control": "error",
		"jsx-a11y/media-has-caption": "error",
		"jsx-a11y/mouse-events-have-key-events": "error",
		"jsx-a11y/no-access-key": "error",
		"jsx-a11y/no-autofocus": "error",
		"jsx-a11y/no-distracting-elements": "error",
		"jsx-a11y/no-noninteractive-tabindex": [
			"error",
			{ "tags": [], "roles": ["tabpanel"], "allowExpressionValues": true },
		],
		"jsx-a11y/no-redundant-roles": "error",
		"jsx-a11y/role-has-required-aria-props": "error",
		"jsx-a11y/role-supports-aria-props": "error",
		"jsx-a11y/scope": "error",
		"jsx-a11y/tabindex-no-positive": "error",
		// Not part of eslint-plugin-jsx-a11y recommended (oxlint addition) —
		// off for rule-posture parity with the eslint canon.
		"jsx-a11y/prefer-tag-over-role": "off",
		// React components are PascalCase (function declarations and arrow
		// consts) — the canon camelCase naming does not fit browser code.
		"stack/naming-convention": "off",
		// 2026-09-18: oxlint >=1.75 turns these two on by default the moment the `react` plugin is
		// enabled — not because this preset asked for them (neither was ever in the list above).
		// A live-acceptance run against one adopting org's existing frontend code found 35
		// unreviewed findings from these two rules alone, 0 elsewhere; the dev catalog stays
		// current regardless (correctness rules are a benefit, not a regression to dodge by
		// pinning old oxlint).
		// TEMPORARY: off until each affected consumer triages its own findings; re-enable per
		// rule as that lands, not as a bulk flip.
		"react/refs": "off",
		"react/set-state-in-effect": "off",
	},
}
