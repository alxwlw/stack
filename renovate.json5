// Renovate самого alxwlw/stack: свои зависимости и пины канона. Пресет канона здесь не подключён —
// он выключает ровно то, что этот репо двигает. Обновления пинов → merge → тег → publish → rollout.
{
	$schema: 'https://docs.renovatebot.com/renovate-schema.json',
	extends: ['config:recommended'],
	// Заменяет, а не дополняет ignorePaths из config:recommended.
	// fixtures/ — семя для тестов, версии в нём не двигаются.
	ignorePaths: ['**/node_modules/**', 'fixtures/**'],
	proto: {
		// Дополняет '**/.prototools' по умолчанию: канон-файл назван без точки.
		managerFilePatterns: ['/^packages/stack/canon/files/prototools$/'],
	},
	customManagers: [
		{
			customType: 'jsonata',
			description: 'Каталоги канона: { <каталог>: { <пакет>: <точная версия> } }',
			fileFormat: 'json',
			managerFilePatterns: ['/^packages/stack/canon/catalogs\\.json$/'],
			matchStrings: ['*.$each(function($v, $k) { { "depName": $k, "currentValue": $v } })'],
			datasourceTemplate: 'npm',
			versioningTemplate: 'npm',
		},
	],
	packageRules: [
		{
			description: 'Ночные 7.1.0-dev.* по семверу старше беты и rc: бот предложил бы их вместо релиза',
			matchPackageNames: ['typescript'],
			allowedVersions: '!/-dev\\./',
		},
		{
			description: 'Свои пакеты и ссылки на себя: версии ставит scripts/release.ts, v1 двигает релиз',
			matchPackageNames: ['@alxwlw/**', 'alxwlw/stack'],
			enabled: false,
		},
		{
			description: 'Одна группа на класс обновления: minor/patch и major идут отдельными ветками, каждая сдвигает зависимость во всех местах сразу — dogfood требует, чтобы канон и корень совпадали',
			groupName: 'canon pins',
			matchFileNames: [
				'packages/stack/canon/files/prototools',
				'packages/stack/canon/catalogs.json',
				'.prototools',
				'pnpm-workspace.yaml',
				'package.json',
			],
		},
		{
			description: 'Связка OpenTelemetry: пакеты пинят друг друга точно, мажор и минор идут одной веткой — иначе у потребителя две копии',
			matchPackageNames: ['@opentelemetry/**'],
			groupName: 'bundle opentelemetry',
			separateMajorMinor: false,
		},
		{
			description: 'Связка NATS: transport-node пинит nats-core точно',
			matchPackageNames: ['@nats-io/**'],
			groupName: 'bundle nats',
			separateMajorMinor: false,
		},
		{
			description: 'Связка Prisma: client, cli и adapter-pg выходят одной версией',
			matchPackageNames: ['@prisma/**', 'prisma'],
			groupName: 'bundle prisma',
			separateMajorMinor: false,
		},
	],
}
