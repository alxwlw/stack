// Renovate самого alxwlw/stack: свои зависимости и пины канона. Пресет канона здесь не подключён —
// он выключает ровно то, что этот репо двигает. Обновления пинов → merge → тег → publish → rollout.
{
	$schema: 'https://docs.renovatebot.com/renovate-schema.json',
	extends: ['config:recommended'],
	// Заменяет, а не дополняет ignorePaths из config:recommended.
	// fixtures/ — семя для тестов, версии в нём не двигаются.
	ignorePaths: ['**/node_modules/**', 'fixtures/**'],
	// pnpm 12 по умолчанию отвергает версии моложе суток (minimumReleaseAge 1440): без этой границы бот
	// предлагает свежий релиз, и `pnpm install` в CI его PR падает (#54: oxfmt 0.79.0 через 3 ч после публикации).
	minimumReleaseAge: '1 day',
	// minimumReleaseAge ставит на ветку статус renovate/stability-days, а у RENOVATE_TOKEN нет права на
	// commit statuses: 403, и Renovate бросает весь прогон («Repository has changed during renovation»).
	// Отбор версий по возрасту от статуса не зависит (internalChecksFilter strict по умолчанию).
	statusCheckNames: { minimumReleaseAge: null },
	proto: {
		// Дополняет '**/.prototools' по умолчанию: канон-файл назван без точки.
		managerFilePatterns: ['/^packages/stack/canon/files/prototools$/'],
	},
	customManagers: [
		{
			customType: 'jsonata',
			description: 'Каталоги канона: { <каталог>: { <пакет>: <точная версия> } }',
			fileFormat: 'json',
			managerFilePatterns: ['/^packages/stack/canon/catalogs\\.json$/'],
			matchStrings: ['*.$each(function($v, $k) { { "depName": $k, "currentValue": $v } })'],
			datasourceTemplate: 'npm',
			versioningTemplate: 'npm',
		},
		// Пины инструментов группы guardrails. Менеджер proto их не видит: инструменты из [plugins] он пропускает
		// как unsupported-datasource (документация менеджера, «Limitations»). Комментарии `# renovate:` в prototools
		// не подходят: канонный файл уходит потребителям, и их Renovate их бы увидел. Значение — только с цифры:
		// строки [plugins] с file:// в то же имя не попадают.
		{
			customType: 'regex',
			description: 'Пин actionlint в prototools: релизы rhysd/actionlint на GitHub',
			managerFilePatterns: ['/^packages/stack/canon/files/prototools$/', '/^\\.prototools$/'],
			matchStrings: ['(?:^|\\n)actionlint\\s*=\\s*"(?<currentValue>\\d[^"]*)"'],
			depNameTemplate: 'actionlint',
			datasourceTemplate: 'github-releases',
			packageNameTemplate: 'rhysd/actionlint',
			extractVersionTemplate: '^v(?<version>.+)$',
		},
		{
			customType: 'regex',
			description: 'Пин shellcheck в prototools: релизы koalaman/shellcheck на GitHub',
			managerFilePatterns: ['/^packages/stack/canon/files/prototools$/', '/^\\.prototools$/'],
			matchStrings: ['(?:^|\\n)shellcheck\\s*=\\s*"(?<currentValue>\\d[^"]*)"'],
			depNameTemplate: 'shellcheck',
			datasourceTemplate: 'github-releases',
			packageNameTemplate: 'koalaman/shellcheck',
			extractVersionTemplate: '^v(?<version>.+)$',
		},
		{
			customType: 'regex',
			description: 'Пин gitleaks в prototools: релизы gitleaks/gitleaks на GitHub',
			managerFilePatterns: ['/^packages/stack/canon/files/prototools$/', '/^\\.prototools$/'],
			matchStrings: ['(?:^|\\n)gitleaks\\s*=\\s*"(?<currentValue>\\d[^"]*)"'],
			depNameTemplate: 'gitleaks',
			datasourceTemplate: 'github-releases',
			packageNameTemplate: 'gitleaks/gitleaks',
			extractVersionTemplate: '^v(?<version>.+)$',
		},
		{
			customType: 'regex',
			description: 'Пин hadolint в prototools: релизы hadolint/hadolint на GitHub',
			managerFilePatterns: ['/^packages/stack/canon/files/prototools$/', '/^\\.prototools$/'],
			matchStrings: ['(?:^|\\n)hadolint\\s*=\\s*"(?<currentValue>\\d[^"]*)"'],
			depNameTemplate: 'hadolint',
			datasourceTemplate: 'github-releases',
			packageNameTemplate: 'hadolint/hadolint',
			extractVersionTemplate: '^v(?<version>.+)$',
		},
		{
			customType: 'regex',
			description: 'Версия yamllint: константа YAMLLINT_VERSION, релизы на PyPI',
			managerFilePatterns: ['/^packages/stack/src/guardrails-yamllint\\.ts$/'],
			matchStrings: ["YAMLLINT_VERSION = '(?<currentValue>[^']+)'"],
			depNameTemplate: 'yamllint',
			datasourceTemplate: 'pypi',
		},
		{
			customType: 'regex',
			description: 'Версия pyyaml для yamllint: константа PYYAML_VERSION, релизы на PyPI',
			managerFilePatterns: ['/^packages/stack/src/guardrails-yamllint\\.ts$/'],
			matchStrings: ["PYYAML_VERSION = '(?<currentValue>[^']+)'"],
			depNameTemplate: 'pyyaml',
			datasourceTemplate: 'pypi',
		},
		{
			customType: 'regex',
			description: 'Версия pathspec для yamllint: константа PATHSPEC_VERSION, релизы на PyPI',
			managerFilePatterns: ['/^packages/stack/src/guardrails-yamllint\\.ts$/'],
			matchStrings: ["PATHSPEC_VERSION = '(?<currentValue>[^']+)'"],
			depNameTemplate: 'pathspec',
			datasourceTemplate: 'pypi',
		},
	],
	packageRules: [
		{
			description: 'Ночные 7.1.0-dev.* по семверу старше беты и rc: бот предложил бы их вместо релиза',
			matchPackageNames: ['typescript'],
			allowedVersions: '!/-dev\\./',
		},
		{
			description: 'Свои пакеты и ссылки на себя: версии ставит scripts/release.ts, v1 двигает релиз',
			matchPackageNames: ['@alxwlw/**', 'alxwlw/stack'],
			enabled: false,
		},
		{
			description: 'Одна группа на класс обновления: minor/patch и major идут отдельными ветками, каждая сдвигает зависимость во всех местах сразу — dogfood требует, чтобы канон и корень совпадали',
			groupName: 'canon pins',
			matchFileNames: [
				'packages/stack/canon/files/prototools',
				'packages/stack/canon/catalogs.json',
				'.prototools',
				'pnpm-workspace.yaml',
				'package.json',
				'packages/stack/package.json',
				'packages/stack/src/guardrails-yamllint.ts',
			],
		},
		// Связки — packages/stack/canon/bundles.json: groupName правила — 'bundle <имя записи>', matchPackageNames — её match; сверяет packages/stack/src/renovate-self.test.ts.
		{
			description: 'Связка OpenTelemetry: пакеты пинят друг друга точно, мажор и минор идут одной веткой — иначе у потребителя две копии',
			matchPackageNames: ['@opentelemetry/**'],
			groupName: 'bundle opentelemetry',
			separateMajorMinor: false,
		},
		{
			description: 'Связка NATS: transport-node пинит nats-core точно',
			matchPackageNames: ['@nats-io/**'],
			groupName: 'bundle nats',
			separateMajorMinor: false,
		},
		{
			description: 'Связка Prisma: client, cli и adapter-pg выходят одной версией',
			matchPackageNames: ['@prisma/**', 'prisma'],
			groupName: 'bundle prisma',
			separateMajorMinor: false,
		},
	],
}
